ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
TOKEN_TTL_SECONDS=3600
TOKEN_STORE_PATH=var/tokens
USER_STORE_PATH=var/users
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
# Set these only in a deployment secret store or local .env; never commit real values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
AUTH_VERIFY_TIMEOUT_MS=500
ALPACA_CONNECT_TIMEOUT_MS=2000
ALPACA_READ_TIMEOUT_MS=10000
